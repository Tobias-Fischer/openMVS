# - Config file for the OpenMVS package
# It defines the imported targets OpenMVS::Common, OpenMVS::Math, OpenMVS::IO and
# OpenMVS::MVS (and the tools) and the variables
#  OpenMVS_INCLUDE_DIRS - include directory of OpenMVS
#  OpenMVS_LIBRARIES    - libraries to link against (OpenMVS::MVS)
#  OpenMVS_BINARIES     - the OpenMVS tools

@PACKAGE_INIT@

# Dependencies of the exported targets
include(CMakeFindDependencyMacro)
find_dependency(Boost COMPONENTS iostreams program_options serialization)
find_dependency(Eigen3 CONFIG)
find_dependency(OpenCV)
find_dependency(CGAL)
find_dependency(nanoflann)
if("@OpenMVS_CONFIG_USE_PNG@")
	find_dependency(PNG)
endif()
if("@OpenMVS_CONFIG_USE_JPG@")
	find_dependency(JPEG)
endif()
if("@OpenMVS_CONFIG_USE_TIFF@")
	find_dependency(TIFF)
endif()
if("@OpenMVS_CONFIG_USE_OPENMP@")
	find_dependency(OpenMP)
endif()
if("@OpenMVS_CONFIG_USE_CUDA@")
	find_dependency(CUDAToolkit)
endif()
if("@OpenMVS_CONFIG_USE_JXL@")
	find_dependency(PkgConfig)
	pkg_check_modules(JPEGXL QUIET REQUIRED IMPORTED_TARGET libjxl)
endif()

set(OpenMVS_VERSION "@OpenMVS_VERSION@")
set(OpenMVS_PREFIX "${PACKAGE_PREFIX_DIR}")
set(OpenMVS_CMAKE_DIR "${CMAKE_CURRENT_LIST_DIR}")
set(OpenMVS_INCLUDE_DIRS "@PACKAGE_INSTALL_INCLUDE_DIR@")
set(OpenMVS_DEFINITIONS "@OpenMVS_DEFINITIONS@")
set(OpenMVS_LIBRARIES OpenMVS::MVS)
set(OpenMVS_BINARIES InterfaceCOLMAP DensifyPointCloud ReconstructMesh RefineMesh TextureMesh)

include("${CMAKE_CURRENT_LIST_DIR}/OpenMVSTargets.cmake")

check_required_components("OpenMVS")
